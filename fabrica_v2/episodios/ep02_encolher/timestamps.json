  {
   "id": "hook",
   "fala": "Você! É, você mesmo! Uma formiga acabou de achar que você é o almoço dela!",
   "t0": 0.0,
   "t1": 5.16
  },
  {
   "id": "premissa",
   "fala": "A partir de hoje, a sua altura cai pela metade todos os dias.",
